# ---------------------------------------------------------------------------
# Arkium AI - exemplo de configuracao. Copie para .env e ajuste os valores.
# ---------------------------------------------------------------------------

# Identidade da plataforma (exibida no painel e na documentacao)
PLATFORM_NAME=Arkium AI
PLATFORM_DESCRIPTION=Plataforma local de IA compativel com a API da OpenAI
PLATFORM_LOGO_URL=/logo.svg

# Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Banco de dados. SQLite por padrao; troque a URL para migrar ao PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/arkium
DATABASE_URL=sqlite:///./data/arkium.db

# Seguranca
SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-longa
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Administrador criado automaticamente na instalacao
ADMIN_EMAIL=admin@arkium.ai
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# Ollama (lista separada por virgula: preparado para multiplos servidores)
OLLAMA_HOSTS=http://localhost:11434
OLLAMA_TIMEOUT=300

# Padroes de inferencia
DEFAULT_MODEL=llama3.2
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048

# Rate limit (janela deslizante em memoria)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Logs
LOG_LEVEL=INFO
LOG_DIR=./logs
